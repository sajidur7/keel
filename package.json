{
  "name": "keel",
  "version": "2.0.0-preview",
  "private": true,
  "type": "module",
  "description": "Keel \u2014 a tactile, dense design system for admin interfaces, styled with StyleX",
  "scripts": {
    "dev": "node scripts/gen-api.mjs && vite --config docs-site/vite.config.ts",
    "build": "node scripts/gen-api.mjs && tsc -p tsconfig.json --noEmit && vite build --config docs-site/vite.config.ts",
    "preview": "vite preview --config docs-site/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "lucide-static": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3",
    "unplugin": "^2.3.11",
    "vite": "^8.3.6"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "safari >= 17.5",
    "firefox >= 120"
  ]
}
