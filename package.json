{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keel — a calm, dense design system for admin interfaces",
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "dev": "npm run tokens && vite --config docs-site/vite.config.ts",
    "build": "npm run tokens && tsc -p tsconfig.json --noEmit && vite build --config docs-site/vite.config.ts",
    "preview": "vite preview --config docs-site/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "lucide-static": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
